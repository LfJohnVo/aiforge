# ==============================================================================
# Agent Forge - plantilla de entorno
# ------------------------------------------------------------------------------
# Copia a `.env` y rellena. NUNCA comitees `.env`.
# Todos los defaults aqui son SEGUROS para desarrollo local (bind a 127.0.0.1,
# sin credenciales reales). Antes de produccion revisa cada bloque marcado [PROD].
# ==============================================================================
#
# NO uses comentarios al final de una linea de valor. `docker compose` los quita, pero
# `docker run --env-file` NO: se lleva el `#` y todo lo que le siga dentro del valor. El
# sintoma es un nombre de instancia que aparece con media frase pegada en las etiquetas de
# Prometheus y en el espacio de nombres del ledger. Los comentarios van en su propia linea.

# ------------------------------------------------------------------------------
# Identidad de la instancia
# ------------------------------------------------------------------------------
AGENT_FORGE_PROFILE=configs/agent.profile.example.yaml
# development | staging | production. En production la celula se niega a arrancar
# sin OIDC (runtime.enforce_production_settings).
AGENT_FORGE_ENV=development
# Sufijo unico por celula en el host.
AGENT_FORGE_INSTANCE=default
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# API publica de la celula
# ------------------------------------------------------------------------------
# [PROD] En produccion se publica detras de un reverse proxy con TLS; no expongas
# el puerto directo. En dev el bind es solo loopback.
AGENT_API_HOST=127.0.0.1
AGENT_API_PORT=8080
AGENT_API_ROOT_PATH=
# Claves de API por tenant, formato: tenant_id:clave,tenant_id2:clave2
# Genera con: python -c "import secrets;print(secrets.token_urlsafe(32))"
AGENT_API_KEYS=
# CORS: lista separada por comas. Vacio = sin CORS (recomendado; usa el proxy).
AGENT_API_CORS_ORIGINS=

# ------------------------------------------------------------------------------
# Identidad del usuario final (OIDC / JWT)
# ------------------------------------------------------------------------------
# Sin identidad verificada el agente SOLO sirve contenido C0 (fail-closed).
OIDC_ISSUER=
OIDC_AUDIENCE=agent-forge
OIDC_JWKS_URL=

# ------------------------------------------------------------------------------
# Estado: Postgres (checkpointer) y Redis (STM, cache semantica)
# ------------------------------------------------------------------------------
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_DB=agentforge
POSTGRES_DSN=postgresql://agentforge:change-me-before-first-run@postgres:5432/agentforge
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Model Gateway (LiteLLM) y backends de inferencia
# ------------------------------------------------------------------------------
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-change-me-before-first-run
LITELLM_SALT_KEY=change-me-before-first-run
# Backends locales - unicos permitidos para datos C3/C4
VLLM_BASE_URL=http://vllm:8000/v1
OLLAMA_BASE_URL=http://ollama:11434
# Backends externos gobernados - SOLO C0-C2 desensibilizado
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# Conocimiento: Qdrant, Neo4j
# ------------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-before-first-run
# Alias de litellm.yaml que sirven embeddings y rerank. Los nombres son alias del
# gateway, no nombres de modelo: la soberania se decide sobre el alias.
#   local/embeddings      bge-m3 en vLLM (necesita GPU)
#   local/embeddings-dev  bge-m3 en Ollama (CPU, o GPU ocupada por el chat)
EMBEDDING_MODEL=local/embeddings
# Vacio = reranker lexico integrado, que no necesita un segundo modelo. Con valor
# (local/rerank) se usa un cross-encoder a traves del gateway.
RERANK_MODEL=

# ------------------------------------------------------------------------------
# Fuentes de ingesta
# ------------------------------------------------------------------------------
# Microsoft Graph (SharePoint / OneDrive) - app registration con Files.Read.All
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Carpeta local montada en el contenedor de ingesta
# Carpeta DEL HOST que se monta como corpus de desarrollo. Dentro del contenedor
# siempre se ve en /data/corpus; esto es solo de donde sale.
CORPUS_HOST_PATH=../../data/corpus
# S3 compatible
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# ------------------------------------------------------------------------------
# Gobernanza (PDP externo) y DLP
# ------------------------------------------------------------------------------
# PDP remoto. Vacio = solo la base Rego local de configs/policies/, que es un despliegue
# soportado (un portatil, una sede aislada) y no uno degradado. Cuando hay PDP, su
# decision es un *overlay*: puede prohibir lo que la base permite, nunca al reves.
GOVERNANCE_PDP_URL=http://opa:8181
GOVERNANCE_PDP_TOKEN=
# closed  = niega C3/C4 y A2+ si el PDP no responde (default, recomendado)
# permissive_c0c1 = ademas permite C0/C1 con decisiones cacheadas ya expiradas
# Ningun modo levanta la restriccion para C3/C4 ni A2+: eso no es configurable.
GOVERNANCE_FAIL_MODE=closed
# TTL corto a proposito: la cache existe para ahorrar una llamada por chunk recuperado,
# no para conservar decisiones. Un cambio de politica debe surtir efecto en segundos.
GOVERNANCE_CACHE_TTL_SECONDS=60
DLP_ENABLED=true

# ------------------------------------------------------------------------------
# Herramientas: MCP Gateway / Tool Fabric, n8n
# ------------------------------------------------------------------------------
MCP_GATEWAY_URL=
MCP_GATEWAY_TOKEN=
N8N_URL=
N8N_API_KEY=
# URL publica de esta celula tal como la ve quien llama desde fuera. La usan el Agent
# Card de A2A, el spec de Copilot Studio y los callbacks de n8n: una URL relativa no le
# sirve a un orquestador.
AGENT_PUBLIC_URL=http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# Canales conversacionales: Teams y Slack
# ------------------------------------------------------------------------------
# Teams: el app id del bot es la audiencia del JWT de Bot Framework. Sin el, el webhook
# rechaza todas las peticiones en vez de aceptar el token de cualquier bot.
TEAMS_APP_ID=
# Mapa identidad -> grupos del tenant. Formato: aadObjectId:grupo1|grupo2,otro:grupo3
# Un usuario ausente del mapa queda autenticado pero sin grupos, y por tanto sin acceso
# a nada con ACL: es lo correcto para quien el directorio no situa.
TEAMS_GROUP_MAP=
# Slack: el signing secret verifica cada peticion (esquema v0, ventana de 5 minutos) y el
# bot token publica la respuesta. Los dos son secretos; nunca van en el repositorio.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_GROUP_MAP=

# ------------------------------------------------------------------------------
# Bases de datos de negocio expuestas como tools (solo lectura por defecto)
# ------------------------------------------------------------------------------
ERP_PG_DSN=
CRM_MYSQL_DSN=
DOCS_MONGO_DSN=

# ------------------------------------------------------------------------------
# Event fabric (NATS JetStream)
# ------------------------------------------------------------------------------
# Vacio = bus en proceso. El modo standalone cierra su propio ciclo con el juez local,
# ejecutando el mismo codigo de publish/subscribe que un despliegue con broker.
NATS_URL=nats://nats:4222
NATS_CREDS_FILE=
# Los streams se llaman PEAK y PEAK_DLQ y los declara la celula al conectar. No son
# configurables: JetStream rechaza dos streams con asuntos solapados, y la pareja
# `peak.>` / `peak-dlq.>` esta elegida para no solaparse.

# ------------------------------------------------------------------------------
# Evidencia / auditoria
# ------------------------------------------------------------------------------
LEDGER_PATH=/var/lib/agent-forge/ledger
# [PROD] Clave HMAC para firmar exportaciones del ledger. Rota trimestralmente.
LEDGER_SIGNING_KEY=

# ------------------------------------------------------------------------------
# Observabilidad
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=agent-forge
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# Langfuse. Sin claves queda desactivado, y eso es un despliegue valido: el perfil puede
# pedirlo sin que el operador lo haya aprovisionado todavia.
#
# ATENCION: Langfuse es un producto alojado por defecto y su valor esta en mostrar prompts
# y respuestas. Por eso la celula solo le envia texto hasta C1; de C2 en adelante manda
# digests, contadores y scores. Un Langfuse autoalojado dentro del perimetro puede
# levantar ese limite, y esa decision es de quien opera, no del codigo.
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
GRAFANA_ADMIN_PASSWORD=change-me-before-first-run
